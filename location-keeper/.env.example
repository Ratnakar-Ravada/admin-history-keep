# Copy to .env (gitignored). Read it with ENV_FILE=/absolute/path/.env.
# Demo is synthetic and only allowed on loopback. It cannot use database credentials.
DATA_SOURCE=demo
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_BASE_URL=http://127.0.0.1:5173
WEB_DIR=../web/dist
CURSOR_TTL_SECONDS=240

# Live mode: DATA_SOURCE=tidb. Configure Google sign-in before connecting private data.
# SESSION_SECRET must be a random value of at least 32 bytes. Keep it server-side.
SESSION_SECRET=
# mysql uses direct TCP 4000; https uses the TiDB Cloud preview HTTPS SQL protocol.
# Choose explicitly; requests are never retried through the other transport.
TIDB_TRANSPORT=mysql
TIDB_DSN=
# Example DSN: viewer:password@tcp(your-tidb-host:4000)/location_keeper?tls=true
PLACE_CACHE_DSN=
# App-only read/write connection for users, sessions and usage tables.
# Blank uses TIDB_DSN locally; tracking queries remain SELECT-only in application code.
APP_DB_DSN=

# Google Cloud OAuth client type: Web application. Google issuer is fixed in code.
# Register PUBLIC_BASE_URL/auth/callback and PUBLIC_BASE_URL/auth/gmail/callback.
# Default Vite mode uses port 5173; the built Go-served app uses port 8080.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact comma-separated Gmail or Google Workspace administrator addresses.
# Advanced analytics access is controlled separately by app_users.is_advanced in TiDB.
GOOGLE_ADMIN_EMAILS=
# Optional immutable Google account IDs for administrator authorization.
# Required instead of email authorization
# for Google accounts using non-Gmail, non-Workspace addresses.
GOOGLE_ADMIN_SUBJECTS=
# Other verified Google accounts require explicit viewer_device_grants rows.
ALLOW_ASSIGNED_USERS=false

# Separate Geoapify keys for server reverse geocoding and browser maps.
# Keep the server key private; restrict by backend outgoing IP when stable.
GEOAPIFY_API_KEY=
# Public browser key. Restrict Allowed origins in Geoapify to the browser origins.
MAP_PUBLIC_KEY=

# Optional Gmail sender connection; ordinary sign-in still requests identity only.
GMAIL_ENABLED=false
GMAIL_SENDER_EMAIL=
# Encrypted server-side token file. Requires stable SESSION_SECRET and durable storage.
GMAIL_TOKEN_FILE=../.private/gmail-sender.enc
