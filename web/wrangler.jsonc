{
  "name": "admin-history-keep",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "routes": [
    { "pattern": "admin-location-keep.rockyworks.in", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/healthz"]
  },
  "vars": {
    "API_ORIGIN": "https://api-admin-location-keep.rockyworks.in",
  },
}
